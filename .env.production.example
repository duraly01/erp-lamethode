# ---------------------------------------------------------------------------
# ERP LaMethode — variables de PRODUCTION
# Copier en `.env.production` et renseigner. NE JAMAIS committer les secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (utilisé par le service `db` et pour composer DATABASE_URL)
POSTGRES_USER="lamethode"
POSTGRES_PASSWORD="CHANGER_moi_mot_de_passe_fort"
POSTGRES_DB="lamethode_prod"

# Auth.js — secret obligatoire en production
# Générer : openssl rand -base64 32
AUTH_SECRET=""
# URL publique de l'application (domaine réel derrière Nginx)
AUTH_URL="https://erp.lamethode.cm"

# Secret du cron pour /api/automations/run
# Générer : openssl rand -hex 24
CRON_SECRET=""
