# ---------------------------------------------------------------------------
# ERP LaMethode — variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Authentification (Auth.js) — posé en Phase 3
# Générer un secret : `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stockage du coffre documentaire (local en dev, S3-compatible en prod) — Phase 4
STORAGE_DRIVER="local"          # local | s3
STORAGE_LOCAL_PATH="./storage"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Clé de chiffrement des documents au repos — Phase 4
# DOCUMENTS_ENCRYPTION_KEY=""

# Automatisations (cron) — secret partagé pour déclencher /api/automations/run
# Générer : openssl rand -hex 24
CRON_SECRET=""
APP_URL="http://localhost:3000"

# --- Canaux de notification ---------------------------------------------
# Email (SMTP). Sans SMTP_HOST, les emails sont seulement « rendus » et loggés (dev).
# SMTP_HOST="smtp.exemple.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
SMTP_FROM="ERP LaMethode <no-reply@lamethode.cm>"

# SMS & WhatsApp via Twilio (optionnel — à brancher).
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_SMS_FROM="+1XXXXXXXXXX"
# TWILIO_WHATSAPP_FROM="+14155238886"

# Environnement
NODE_ENV="development"
