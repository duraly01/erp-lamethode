{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx src/scripts/check-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:node": "node scripts/migrate.mjs",
    "db:baseline": "node scripts/baseline.mjs",
    "db:privileges": "node scripts/db-privileges.mjs",
    "db:fix-owner": "node scripts/fix-owner.mjs",
    "db:facturation": "node scripts/facturation-audit.mjs",
    "check:build": "node scripts/check-build.mjs",
    "fix:perms": "node scripts/fix-permissions.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "automations": "tsx src/scripts/automations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:comptabilite": "tsx --tsconfig tsconfig.scripts.json src/scripts/verify-comptabilite.ts",
    "verify:e1": "npm run db:migrate:local && npm run verify:comptabilite",
    "db:migrate:local": "node scripts/migrate-local.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "17.3.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.19.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "vitest": "^4.1.10"
  }
}
